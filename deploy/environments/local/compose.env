# Variables Compose itself interpolates for a local stack.
#
# Not the backend's environment: that comes from backend/.env via env_file.
# These are the values used in ${...} substitutions inside the compose files -
# build args and the Postgres password - which env_file provably does not reach.

APP_NETWORK_NAME=pestbase-app

# Where this machine's existing data already lives. Compose named these volumes
# after the old project name, and a volume cannot be renamed in place - so they
# are pinned here rather than moved, and nothing has to be copied.
#
# Check the names match before the next `up`:
#
#     docker volume ls
#
# To finish the rename properly and delete these two lines, copy each volume
# once while the stack is down:
#
#     docker run --rm -v qkil-local_mongo-data:/from -v pestbase-mongo-data:/to `
#       alpine sh -c "cp -a /from/. /to/"
#     docker run --rm -v qkil-local_postgres-data:/from -v pestbase-postgres-data:/to `
#       alpine sh -c "cp -a /from/. /to/"
#
# Then `up -d`, confirm your clients and sign-in still work, and only then
# `docker volume rm qkil-local_mongo-data qkil-local_postgres-data`.
MONGO_VOLUME_NAME=qkil-local_mongo-data
POSTGRES_VOLUME_NAME=qkil-local_postgres-data

# Local only. A hosted deployment puts a real secret in
# deploy/runtime/<env>/compose.env, which is gitignored.
POSTGRES_PASSWORD=supertokens_local_only

# Empty: the portal calls its own origin and nginx proxies /api and /auth to the
# backend. Set this only if you serve the API from a different host.
VITE_API_ORIGIN=

# Must match the backend's AUTH_* settings. See frontend/src/config/authPaths.js
# for why the two paths differ from each other.
VITE_AUTH_API_BASE_PATH=/auth
VITE_AUTH_WEBSITE_BASE_PATH=/login

# What the browser calls, which is the portal's origin because of the proxy.
AUTH_API_DOMAIN=http://localhost:3000
AUTH_WEBSITE_DOMAIN=http://localhost:3000
