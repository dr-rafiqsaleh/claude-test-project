# Optional build settings. Copy to .env.production (gitignored) to use them.
#
# Where the contact form posts. A built site defaults to the app's origin,
# https://app.pestbase.co.uk, which serves the API; set this only to point the
# form somewhere else, such as a staging API. No trailing slash. Whichever API
# it is must list this website's origin in its CORS_ORIGINS.
# VITE_API_ORIGIN=https://app.pestbase.co.uk
