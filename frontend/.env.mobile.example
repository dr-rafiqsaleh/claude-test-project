# The Android and iOS apps' build. Copy to .env.mobile (gitignored) and set it.
#
# The app runs from inside the phone, so it must be told where the API is: the
# portal's public origin, which proxies /api and /auth to the backend. No
# trailing slash. The backend must list capacitor://localhost and
# https://localhost in CORS_ORIGINS.
VITE_API_ORIGIN=https://app.pestbase.co.uk

# Must match the backend's AUTH_API_BASE_PATH and AUTH_WEBSITE_BASE_PATH.
VITE_AUTH_API_BASE_PATH=/auth
VITE_AUTH_WEBSITE_BASE_PATH=/login
