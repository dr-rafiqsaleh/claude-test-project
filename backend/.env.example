MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=pestbase_db
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- SuperTokens (sign-in) ---------------------------------------------------
# Sign-in is passwordless: PestBase emails a link and a six-digit code, and there
# are no passwords anywhere. SuperTokens keeps the credentials and the sessions;
# PestBase keeps the accounts, roles and clients.
#
# Inside docker compose the core is reached at http://supertokens:3567 and the
# compose file sets that itself. This default is for running the backend
# directly on the host against a core started with:
#   ./scripts/compose.sh local up -d supertokens
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
# Only if the core is configured with one.
SUPERTOKENS_API_KEY=

AUTH_APP_NAME=PestBase

# What the BROWSER calls, not what the container calls. Behind the portal's
# nginx both are the portal's own origin, which is what makes the session
# cookies first-party and means no CORS is involved between portal and API.
AUTH_API_DOMAIN=http://localhost:3000
AUTH_WEBSITE_DOMAIN=http://localhost:3000

# Where SuperTokens' endpoints live, and where the sign-in page lives. They must
# differ from each other, and must match the frontend's VITE_AUTH_* build args -
# see frontend/src/config/authPaths.js for both reasons.
AUTH_API_BASE_PATH=/auth
AUTH_WEBSITE_BASE_PATH=/login

# Forced on in production regardless of this.
AUTH_COOKIE_SECURE=false

# How many sign-in codes one address may ask for in a window. Asking to sign in
# makes PestBase send an email, so without a limit anyone who knows a colleague's
# address can have us mail them a code every second.
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Sign-in emails. Left empty, SuperTokens sends them through its own service:
# the code arrives with no mail setup at all, which is how to try this out, but
# it is rate limited and the mail is not from your domain. Fill these in for
# anything real. Separate from the per-client SMTP used for quotes and invoices,
# because this sends before we know which client an address belongs to.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_FROM_NAME=PestBase
AUTH_SMTP_SECURE=false

# Encrypts secrets stored in the database (the SMTP password). Not sign-in.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes everything already stored undecryptable.
SECRET_KEY=
